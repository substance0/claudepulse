{
  "name": "claudepulse",
  "version": "2.0.0",
  "description": "Automated Claude Code session renewal with intelligent pulse scheduling for maximum Pro/Max subscription value",
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src/",
    "Dockerfile",
    "docker-compose.yml",
    "README.md",
    "ENVIRONMENT.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"test/*.test.js\"",
    "dev": "NODE_ENV=development LOG_LEVEL=DEBUG node src/index.js",
    "prod": "NODE_ENV=production LOG_LEVEL=INFO node src/index.js",
    "lint": "echo 'Linting JavaScript files...' && find src -name '*.js' -exec node -c {} \\;",
    "docker:build": "docker build -t claudepulse . --load",
    "docker:build:fresh": "docker build --no-cache -t claudepulse . --load",
    "docker:run": "docker run -dt --name claudepulse claudepulse",
    "docker:run:hold": "docker run -dt --name claudepulse -e KEEP_PULSE_ON_FAILURE=true claudepulse",
    "docker:run:interactive": "docker run -it --name claudepulse claudepulse",
    "docker:run:restart": "docker run -dt --name claudepulse --restart unless-stopped claudepulse",
    "docker:bash": "docker exec -it claudepulse /bin/sh",
    "docker:start": "docker start claudepulse",
    "docker:stop": "docker stop claudepulse",
    "docker:rm": "docker rm claudepulse",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker logs claudepulse",
    "docker:restart": "npm run docker:down && npm run docker:up",
    "docker:clean": "docker system prune -f && docker image prune -f",
    "logs": "mkdir -p logs && tail -f logs/claudepulse.log"
  },
  "keywords": [
    "claude",
    "anthropic",
    "automation",
    "oauth",
    "oauth2",
    "pkce",
    "session",
    "pulse",
    "scheduler",
    "docker",
    "cli",
    "ai"
  ],
  "author": {
    "name": "ClaudePulse Project",
    "email": "contact@claudepulse.dev",
    "url": "https://github.com/claudepulse/claudepulse"
  },
  "license": "MIT",
  "homepage": "https://github.com/substance0/claudepulse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substance0/claudepulse.git"
  },
  "bugs": {
    "url": "https://github.com/substance0/claudepulse/issues"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "semantic-release": "^25.0.9"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/claudepulse"
  },
  "config": {
    "logLevel": "INFO",
    "defaultInterval": "5",
    "maxRetries": "3"
  }
}
